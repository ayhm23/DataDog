# ─────────────────────────────────────────────────────────────────────────────
# .env.example  — Copy to .env and fill in real values before running locally.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Redis (ingestion-service, all workers, websocket-gateway, query-api) ──────
REDIS_URL=redis://redis:6379

# ── MongoDB (mongo-writer, rollup-worker, query-api) ───────────────────────────
MONGO_URL=mongodb://mongo:27017
MONGO_DB=tracing

# ── PostgreSQL (rollup-worker, query-api) ──────────────────────────────────────
PG_DSN=postgresql://admin:admin@postgres:5432/tracing

# ── anomaly-worker ──────────────────────────────────────────────────────────────
ERROR_RATE_THRESHOLD=0.05
P95_THRESHOLD_MS=1000
ALERT_COOLDOWN_S=60

# ── rollup-worker ───────────────────────────────────────────────────────────────
ROLLUP_INTERVAL_S=3600

# ── websocket-gateway ────────────────────────────────────────────────────────────
POLL_INTERVAL_S=2
HEARTBEAT_S=30

# ── docker-compose host port overrides ──────────────────────────────────────────
# Uncomment if port 8080 is already taken on your machine, and update
# dashboard/.env's VITE_WS_URL to match.
# WS_HOST_PORT=8090

# Dashboard env vars (VITE_WS_URL, VITE_QUERY_URL) live in dashboard/.env —
# see dashboard/.env.example.
